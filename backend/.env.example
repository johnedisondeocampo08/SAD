NODE_ENV=development
PORT=5000

DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=simula_studio_db

# Generate a random secret of at least 32 characters and use the same value
# in Google Apps Script > Project Settings > Script Properties.
BOOKING_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
